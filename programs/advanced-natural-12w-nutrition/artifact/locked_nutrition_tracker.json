  "measurement_protocol": {
    "daily_bodyweight": {
      "required": true,
      "conditions": [
        "morning",
        "after_bathroom",
        "before_food_or_fluid",
        "same_scale",
        "similar_clothing_or_state"
      ]
    },
    "display_metric": "7_day_average",
    "decision_horizon_days": {
      "min": 14,
      "max": 21
    },
    "trend_method": {
      "default": "14_day_linear_regression",
      "method_must_remain_consistent_for_full_block": true,
      "note": "Estimator choice is implementation detail; consistency is locked."
    },
    "waist": {
      "role": "corroborative_only",
      "hard_cutoff_cm": null,
      "standardized_repeated_measurements": true
    },
    "photos": {
      "role": "corroborative_only",
      "recommended_weeks": [
        0,
        4,
        8,
        12
      ]
    },
    "bodyfat_estimate": {
      "role": "descriptive_only",
      "automatic_calorie_trigger": false,
      "approx_reassessment_annotation_pct": 16.0
    }
  },
  "controller_timing": {
    "weeks_1_2": {
      "routine_bodyweight_driven_changes": false,
      "exceptions": [
        "GI_intolerance",
        "obvious_logging_error",
        "illness",
        "clearly_falling_trend",
        "implementation_mistake"
      ]
    },
    "first_routine_decision": "end_of_week_3",
    "subsequent_decision_interval_days_approx": 14,
    "after_any_adjustment": "wait_for_new_qualified_trend_before_next_routine_change"
  },
  "controller_rules": [
    {
      "id": "UNDER_GAIN",
      "condition": "qualified_trend_pct_bw_per_week < 0.10",
      "recommended_action": "ADD_CALORIES",
      "delta_kcal_per_day": 150,
      "primary_macro_adjusted": "carbohydrate",
      "automatic_apply": false,
      "classification": "HEURISTIC"
    },
    {
      "id": "IN_RANGE",
      "condition": "0.10 <= qualified_trend_pct_bw_per_week <= 0.25",
      "recommended_action": "NO_CHANGE",
      "delta_kcal_per_day": 0,
      "automatic_apply": false
    },
    {
      "id": "OVER_GAIN",
      "condition": "qualified_trend_pct_bw_per_week > 0.25 sustained",
      "recommended_action": "REDUCE_CALORIES",
      "delta_kcal_per_day": -100,
      "primary_macro_adjusted": "carbohydrate",
      "automatic_apply": false,
      "classification": "HEURISTIC"
    },
    {
      "id": "VERY_RAPID_GAIN_WITH_COMPOSITION_CONCERN",
      "condition": "qualified_trend_pct_bw_per_week > 0.30 AND corroborating_composition_deterioration",
      "recommended_action": "STRONGER_REASSESSMENT",
      "automatic_apply": false
    }
  ],
  "diagnostic_gate": {
    "trigger": "two_consecutive_qualified_under_gain_corrections_of_plus_150_fail_to_move_trend_into_band",
    "automatic_third_increase": false,
    "rule": "audit_before_continuing",
    "checks": [
      "calorie_tracking_method_unchanged",
      "foods_logged_consistently",
      "restaurant_or_unlogged_intake_reviewed",
      "weighing_protocol_unchanged",
      "activity_or_NEAT_materially_changed",
      "training_workload_materially_changed",
      "sleep_or_recovery_materially_changed",
      "illness_or_travel_disrupted_data",
      "adherence_actually_consistent"
    ],
    "if_genuine_underfeeding_confirmed": "another_plus_150_kcal_per_day_permitted",
    "if_inputs_unreliable": "fix_input_problem_first",
    "classification": "STRONG_CONTROL_LOGIC_INFERENCE_HEURISTIC_THRESHOLD"
  },
  "partitioning_override": {
    "hard_waist_threshold": null,
    "hard_bodyfat_threshold": null,
    "trigger_logic": [
      "bodyweight_rate_inside_success_band",
      "repeated_standardized_waist_trend_concerning",
      "week_4_photo_comparison_concerning",
      "no_clear_training_or_recovery_advantage"
