    "action": "do_not_increase_calories_to_chase_73_5kg; consider_modest_reduction_after_review",
    "automatic_apply": false
  },
  "performance_signal": {
    "role": "diagnostic_flag_only",
    "does_not_automatically_mean": [
      "eat_more",
      "eat_less",
      "deload",
      "do_not_deload"
