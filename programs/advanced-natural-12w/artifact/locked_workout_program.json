      "weekly_sets_deload": 48,
      "volume_reduction_pct_approx": 41,
      "rep_target": "lower half of normal rep ranges",
      "RIR": 4,
      "failure": "NONE",
      "load_rule": "retain prior load only if reduced reps still allow >=4 RIR; otherwise reduce load"
    }
  },
